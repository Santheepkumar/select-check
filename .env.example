# SelectCheck Environment Configuration

# Local Edge API Server Port
PORT=8787

# OpenAI API Configuration
# Optional: If not provided, SelectCheck falls back to the local heuristic suggestions engine
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# JWT Secret for local dev OTP authentication
JWT_SECRET=select-check-dev-jwt-secret-key

# Daily suggestion quota limits
FREE_DAILY_LIMIT=10
AUTH_DAILY_LIMIT=100

# Optional Supabase / Cloudflare config
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
