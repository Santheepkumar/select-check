# Load local environment variables from .env and .env.local
dotenv_if_exists .env
dotenv_if_exists .env.local

# Also load apps/api/.env or .dev.vars if present
dotenv_if_exists apps/api/.env
dotenv_if_exists apps/api/.dev.vars

# Add node_modules/.bin to PATH while in this project
PATH_add node_modules/.bin
